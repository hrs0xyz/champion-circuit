# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=Champion Circuit API
ENVIRONMENT=local
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=sqlite:///./champion_circuit.db
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
PUBLIC_BASE_URL=http://127.0.0.1:8000

# ==============================================================================
# AWS SES EMAIL SERVICE (PRODUCTION)
# ==============================================================================
# AWS Region where SES is configured
AWS_REGION=ap-south-1

# AWS Credentials (for Render, local development)
# Leave empty if using IAM roles (ECS, EC2, Lambda)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# SES Sender Configuration
# This email must be verified in AWS SES console
SES_FROM_EMAIL=official@championcircuit.com
SES_FROM_NAME=Champion Circuit

# Important Notes:
# 1. Verify your sender email in AWS SES Console before sending
# 2. If in SES Sandbox mode, verify recipient emails too
# 3. Request production access to send to any email
# 4. For ECS/EC2, use IAM roles instead of access keys (more secure)

# ==============================================================================
# LEGACY SMTP (DEPRECATED - Remove after SES migration)
# ==============================================================================
# Gmail SMTP — generate an App Password at:
# myaccount.google.com → Security → 2-Step Verification → App passwords
# NOTE: These settings are no longer used. Remove after confirming SES works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ==============================================================================
# PAYMENT & CLOUD SERVICES
# ==============================================================================
# Razorpay — get from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=XXXX

# Cloudinary — get from cloudinary.com console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
